msgid "Entrar com Gov.br"
msgstr "Entrar com Gov.br"

msgid "O e-mail vinculado ao Gov.br já está em uso. Informe um novo e-mail para criar sua conta."
msgstr "O e-mail vinculado ao Gov.br já está em uso. Informe um novo e-mail para criar sua conta."

msgid "O e-mail informado não é válido. Verifique e tente novamente."
msgstr "O e-mail informado não é válido. Verifique e tente novamente."

msgid "O e-mail informado já está em uso. Tente outro e-mail."
msgstr "O e-mail informado já está em uso. Tente outro e-mail."

msgid "Foram encontrados vários cadastros com este CPF. Entre em contato com o suporte para resolver a duplicidade."
msgstr "Foram encontrados vários cadastros com este CPF. Entre em contato com o suporte para resolver a duplicidade."

msgid "Não foi possível autenticar com Gov.br. Tente novamente ou use outra forma de login."
msgstr "Não foi possível autenticar com Gov.br. Tente novamente ou use outra forma de login."

msgid "Você cancelou a autenticação no Gov.br. Escolha outra forma de entrar."
msgstr "Você cancelou a autenticação no Gov.br. Escolha outra forma de entrar."

msgid "Sua conta Gov.br foi vinculada ao seu cadastro existente. Se você não reconhece esta ação, entre em contato com o suporte."
msgstr "Sua conta Gov.br foi vinculada ao seu cadastro existente. Se você não reconhece esta ação, entre em contato com o suporte."
